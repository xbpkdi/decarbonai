{
  "name": "rwa-carbon-offset",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "spike:carbonmark": "node --experimental-strip-types --env-file=.env spike/retire.ts",
    "spike:klima": "node --experimental-strip-types --env-file=.env spike/klima-retire.ts",
    "compile:contract": "node --experimental-strip-types spike/compile-contract.ts",
    "deploy:fuji": "node --experimental-strip-types --env-file=.env spike/deploy-receipt.ts",
    "deploy:fuji:wait": "node --experimental-strip-types --env-file=.env spike/wait-and-deploy.ts",
    "e2e:demo": "node --experimental-strip-types --env-file=.env spike/e2e-demo.ts",
    "dev": "npm run dev -w web",
    "build": "npm run build -w web",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint",
    "test": "npm run test -w @decarbonai/x402-carbon && npm run test -w paid-api && node --test scripts/test/*.test.ts",
    "contracts:build": "cd packages/contracts && forge build",
    "contracts:test": "cd packages/contracts && forge test",
    "contracts:coverage": "cd packages/contracts && forge coverage --report summary --no-match-coverage '(test|script)/'",
    "contracts:abis": "node scripts/gen-abis.mjs",
    "api": "npm run start -w paid-api",
    "mcp": "npm run start -w @decarbonai/mcp-server",
    "setup:agent": "node --env-file=.env scripts/setup-agent.ts",
    "demo:burst": "node --env-file=.env --no-warnings=ExperimentalWarning scripts/demo-burst.ts",
    "smoke:fuji": "node --env-file=.env --no-warnings=ExperimentalWarning scripts/smoke-fuji.ts",
    "setup:merchant": "node --env-file=.env --no-warnings=ExperimentalWarning scripts/setup-merchant.ts",
    "reconcile": "node --env-file=.env --no-warnings=ExperimentalWarning scripts/reconcile.ts",
    "retire:lot1": "node scripts/klima-retire.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.6",
    "solc": "^0.8.24.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@decarbonai/chain": "*",
    "@decarbonai/core": "*",
    "@decarbonai/x402-carbon": "*",
    "@hono/node-server": "^1.19.0",
    "viem": "^2.33.2"
  }
}
