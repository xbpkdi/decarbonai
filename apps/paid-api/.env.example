# The paid API's own env: apps/paid-api/.env (never commit it). It must not hold any other key than the meter's;
# the server exits if it finds one. `npm run api` does not read the root .env.

# fuji | avalanche
DECARBONAI_NETWORK=fuji
# METER_ROLE-only key of that network
METER_PRIVATE_KEY=
# Merchant payTo wallet (address only)
PAY_TO_ADDRESS=
# Durable accrual queue, absolute path, one per chain and pool.
# Blank: apps/paid-api/.data/accruals-<chainId>-<pool>.sqlite
ACCRUAL_DB=
FUJI_RPC_URL=
MAINNET_RPC_URL=
X402_FACILITATOR_URL=
# 1 only behind a proxy that sets X-Forwarded-For
TRUST_PROXY=
