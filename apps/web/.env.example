# Network: fuji (default) or mainnet. Contract addresses come from deployments/<network>.json.
NEXT_PUBLIC_NETWORK=fuji
# Optional RPC override (server reads RPC_URL first, the browser uses NEXT_PUBLIC_RPC_URL).
# RPC_URL=
# NEXT_PUBLIC_RPC_URL=
# Public site URL for OG/QR links.
# Defaults to this Vercel deployment (VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL), else decarbonai.vercel.app.
# NEXT_PUBLIC_SITE_URL=
# ERC-8004 id -> display name. Unknown ids show as "Agent #id".
NEXT_PUBLIC_AGENT_NAMES={"360":"Claude research agent"}
# Agent shown on the Live pool card (default: the demo agent, else whoever paid last).
# NEXT_PUBLIC_FEATURED_AGENT_ID=
# WalletConnect project id (QR wallets). Extension wallets work without it.
# NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Real Fuji activity for Developers "Run" and Agent "Pay one call" (server-side, Fuji only, rate-limited).
# Use a TEST key funded with test USDC only. Never a mainnet key.
NEXT_PUBLIC_DEMO_AGENT_ID=
NEXT_PUBLIC_DEMO_API_URL=
DEMO_API_URL=
DEMO_AGENT_PRIVATE_KEY=
