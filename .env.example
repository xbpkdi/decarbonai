# Never commit .env. Values below are placeholders.

# --- Avalanche Fuji (DecarbonAI v2) ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# One key per role. No role falls back to another role's key.
# Deployer = pool admin/treasury/pauser on Fuji (a Safe on mainnet).
FUJI_PRIVATE_KEY=
# Meter: METER_ROLE only. The API has its own env (apps/paid-api/.env) and refuses any other key; it does not read this file.
METER_PRIVATE_KEY=
# payTo: receives x402 revenue and funds surcharges (approves the pool once: npm run setup:merchant).
PAY_TO_PRIVATE_KEY=
# The API only needs the payTo address.
PAY_TO_ADDRESS=
# Durable accrual queue, absolute path, one per chain and pool (blank: apps/paid-api/.data/accruals-<chainId>-<pool>.sqlite).
ACCRUAL_DB=
# Demo agent wallet that pays over x402 (create with any wallet; fund via `npm run setup:agent`).
AGENT_PRIVATE_KEY=
# ERC-8004 agent id printed by `npm run setup:agent`.
AGENT_ID=
# Paid API used by the MCP server / demo (default http://localhost:4021).
API_URL=
# x402 facilitator (default https://facilitator.payai.network).
X402_FACILITATOR_URL=

# MCP server spend controls (units of 6-decimal USDC).
MAX_PAYMENT_UNITS=100000
MAX_SESSION_UNITS=1000000
MAX_SESSION_CALLS=200

# --- Avalanche C-Chain mainnet (prepared, not deployed). Admin/treasury = Safe, never a local key. ---
MAINNET_RPC_URL=https://api.avax.network/ext/bc/C/rpc
MAINNET_PRIVATE_KEY=
MAINNET_METER_PRIVATE_KEY=
MAINNET_PAY_TO_PRIVATE_KEY=
MAINNET_AGENT_PRIVATE_KEY=
MAINNET_AGENT_ID=
# Base wallet that buys and retires lot 1 (scripts/klima-retire.ts --execute).
BASE_BUYER_PRIVATE_KEY=

# --- v1 legacy (Carbonmark retirement route, disabled unless OFFSET_ADMIN_TOKEN is set) ---
OFFSET_ADMIN_TOKEN=
CARBONMARK_API_KEY=
CARBONMARK_BASE_URL=https://v19.api.carbonmark.com
BENEFICIARY_NAME="RWA Carbon Offset Spike"
BENEFICIARY_ADDRESS=0x000000000000000000000000000000000000dEaD
KLIMA_X402_BASE_URL=https://v1.x402.klimalabs.com
KLIMA_CHAIN_ID=84532
KLIMA_PRIVATE_KEY=
CERTIFICATE_RECEIPT_ADDRESS=
